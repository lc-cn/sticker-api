# Loopback only by default. Do not expose this service to the public internet.
HOST=127.0.0.1
PORT=8787

# Required bearer token for /v1/* routes. Replace before use.
# Example only — never commit a real token.
STICKER_API_TOKEN=replace-with-a-long-random-secret

# Absolute or relative paths. Relative paths resolve from process cwd.
DATA_DIR=./data
STICKERS_DIR=./data/stickers
DB_PATH=./data/stickers.db

# Upload limits
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_DIMENSION=4096

# Optional short-lived response cache for file GETs (seconds). Does not delete originals.
FILE_CACHE_TTL_SECONDS=60
