# sticker-api (B) — copy to .env for local runs; on Vercel set these as Project Environment Variables.
# Never commit real values. Everything secret below is marked [SECRET].

# ---- Public URL (must be https in production; http only for 127.0.0.1 with STICKER_ALLOW_HTTP_LOOPBACK=1)
PUBLIC_BASE_URL=https://sticker-api.example.vercel.app
# STICKER_ALLOW_HTTP_LOOPBACK=1

# ---- A repo (sticker-assets): the ONLY source of truth
A_REPO_OWNER=your-github-user
A_REPO_NAME=sticker-assets
A_REPO_BRANCH=main
# raw = read files at a pinned commit via raw.githubusercontent.com (default); api = via contents API with the App token
A_READ_SOURCE=raw
# Overrides (tests/local fakes only)
# GITHUB_API_BASE=https://api.github.com
# GITHUB_OAUTH_BASE=https://github.com
# A_RAW_BASE=https://raw.githubusercontent.com

# ---- Writer GitHub App (Fin creates): Repository permissions -> Contents: Read & write; Metadata: Read.
# Install it on the A repo ONLY. Webhook off. No user authorization needed for this App.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# [SECRET] PEM private key, either with literal \n escapes or base64 of the whole PEM
GITHUB_APP_PRIVATE_KEY=

# ---- Admin login GitHub App (Fin creates, SEPARATE from the writer): NO repository/account permissions.
# Callback URL = ${PUBLIC_BASE_URL}/v1/auth/github/callback ; "Request user authorization (OAuth) during installation" off;
# "Expire user authorization tokens" on. Used only to learn the numeric GitHub user id; the token is revoked immediately.
GITHUB_LOGIN_CLIENT_ID=
# [SECRET]
GITHUB_LOGIN_CLIENT_SECRET=
GITHUB_LOGIN_REDIRECT_URI=https://sticker-api.example.vercel.app/v1/auth/github/callback
# Numeric GitHub user ids (not logins), comma separated. `gh api user --jq .id`. Malformed => admin login disabled.
ADMIN_GITHUB_USER_IDS=

# ---- Admin session cookie
# [SECRET] base64 of >=32 random bytes: `openssl rand -base64 32`
SESSION_SECRET=
SESSION_TTL_SECONDS=1800

# ---- Machine callers (Xiaozhi etc.). Hashes only; generate with `pnpm token:new xiaozhi assets:write,render,operations:read`
# scopes: assets:write assets:moderate operations:read collect:trigger render
MACHINE_TOKENS=[]

# ---- Idempotency HMAC keys (newest first; old keys kept for replay lookup). [SECRET]
# `echo "k1:$(openssl rand -base64 32)"`
IDEMPOTENCY_HMAC_KEYS=

# ---- Mirrors: hosts B may redirect to (intersected with A config/mirrors.json enabled+verified). Empty = raw only.
MIRROR_HOST_ALLOWLIST=

# ---- HEAD freshness (seconds); beyond TTL+stale with GitHub unreachable => 503 state_unverifiable
HEAD_TTL_SECONDS=15
HEAD_MAX_STALE_SECONDS=30

# ---- Kill switches
WRITES_ENABLED=true
RENDERS_ENABLED=true
CONTENT_ENABLED=true

# ---- Limits
PUBLISH_MAX_ATTEMPTS=4
RENDER_TIMEOUT_MS=10000
RENDER_PER_MINUTE=30
# Fonts for templates: "<fontId>=<Family>@<path relative to project root>;..." fontId must match A template fonts.
# Put an OFL font file under fonts/ (bundled via vercel.json includeFiles). Example:
RENDER_FONTS=default-sans=Noto Sans SC@fonts/NotoSansSC-Regular.otf

# ---- Public homepage: anonymous renders (POST /v1/renders without a token). OFF by default.
# Limits are per client IP and kept IN MEMORY PER INSTANCE (each warm Vercel instance counts separately) — not a global quota.
PUBLIC_RENDERS_ENABLED=false
PUBLIC_RENDER_PER_MINUTE=6
PUBLIC_RENDER_PER_DAY=100
# Use x-real-ip / first x-forwarded-for hop as the client IP. Only safe behind a proxy that overwrites them.
# Default: true when VERCEL=1 (set automatically by Vercel), false elsewhere (socket peer address is used).
# TRUST_PROXY_HEADERS=

# ---- Admin console: collection trigger (POST /v1/collect-runs → A workflow_dispatch)
# Requires the writer GitHub App to have Repository permission "Actions: Read and write".
COLLECT_WORKFLOW=collect.yml
COLLECT_COOLDOWN_SECONDS=300
