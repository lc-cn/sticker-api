{
  "name": "sticker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "小智表情服务 B：单 Vercel、无状态 API；A 仓库(sticker-assets)为唯一权威",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/copy-vendor-data.mjs",
    "start": "node dist/src/server.js",
    "test": "pnpm build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "smoke": "pnpm build && node dist/scripts/smoke.js",
    "vendor:a": "node scripts/vendor-assets-contract.mjs ../sticker-assets",
    "token:new": "node scripts/new-machine-token.mjs"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.5",
    "@resvg/resvg-wasm": "2.6.2",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
