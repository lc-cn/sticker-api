{
  "name": "sticker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent sticker pack API for Xiaozhi: upload, dedupe, search, serve originals",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "smoke": "pnpm build && node dist/scripts/smoke.js"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
